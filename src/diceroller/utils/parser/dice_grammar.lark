    %import common.INT
    %import common.WS
    %ignore WS

    start: expr

    ?expr: term (operator term)*

    operator: "+" -> add
            | "-" -> sub

    ?term: dice_expr
         | INT -> modifier

    ?dice_expr: count? "d" sides roll_modifier*

    count: INT
    sides: INT

    roll_modifier: "kh" INT? -> keep_highest
                 | "kl" INT? -> keep_lowest
                 | "dh" INT? -> drop_highest
                 | "dl" INT? -> drop_lowest
