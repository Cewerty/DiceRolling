%import common.INT
%import common.WS
%ignore WS

start: expr

?expr: term ((("+" | "-") term))*

?term: dice_expr
     | INT -> modifier

dice_expr: INT? "d" INT roll_modifier*

roll_modifier: "kh" INT -> keep_highest
             | "kl" INT -> keep_lowest
             | "dh" INT -> drop_highest
             | "dl" INT -> drop_lowest
